# --- Base de datos ----------------------------------------------------------
DATABASE_URL="postgresql://usuario:password@localhost:5432/tarjetas"
DIRECT_URL="postgresql://usuario:password@localhost:5432/tarjetas"

# --- Redis (opcional) -------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Aplicación -------------------------------------------------------------
NODE_ENV=development
PORT=3001
APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"
CORS_ORIGINS="http://localhost:3000"

# --- Autenticación ----------------------------------------------------------
# Generar secretos largos y aleatorios para cada variable.
JWT_ACCESS_SECRET="cambiar-por-un-secreto-de-acceso"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="cambiar-por-un-secreto-de-refresh"
REFRESH_TTL_DAYS=30
HASH_PEPPER="cambiar-por-un-pepper-largo-y-aleatorio"

# --- Super administrador inicial (seed) ------------------------------------
SUPER_ADMIN_EMAIL="admin@tarjetas.app"
SUPER_ADMIN_PASSWORD="cambiar-esta-password"

# --- Google OAuth (opcional) -----------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (opcional) -------------------------------------------------------
MAIL_API_KEY=""
MAIL_FROM="Tarjetas.app <no-reply@tarjetas.app>"

# --- Cloudflare R2 (opcional) ----------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY=""
R2_SECRET=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# --- Mercado Pago (opcional) -----------------------------------------------
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# --- Observabilidad (opcional) ---------------------------------------------
SENTRY_DSN=""
